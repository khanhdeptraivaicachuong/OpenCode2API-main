# ============================================================
# opencode2api - environment configuration
#
# Works for BOTH:
#   - direct launch (npm start / start.bat / start.sh)
#   - Docker (this file is loaded as .env by docker compose)
#
# Priority order: real env var > this file > config.json > default
# ============================================================

# ---- Required ----
# Set a strong random value for production use.
API_KEY=change-me

# Password for the local OpenCode server (passed as `opencode serve --password ...`).
OPENCODE_SERVER_PASSWORD=change-me-too

# ---- Tool safety ----
# Keep true unless you specifically want model tool access.
DISABLE_TOOLS=true

# ---- External tool bridge ----
OPENCODE_EXTERNAL_TOOLS_MODE=proxy-bridge
OPENCODE_EXTERNAL_TOOLS_CONFLICT_POLICY=namespace

# ---- OpenCode CLI binary ----
# Leave as 'opencode' to auto-detect. Override with absolute path if needed.
# Windows : C:\Users\YourName\AppData\Roaming\npm\opencode.cmd
# Linux   : /home/yourname/.local/bin/opencode
# macOS   : /opt/homebrew/bin/opencode
OPENCODE_PATH=opencode

# ---- Networking ----
# Proxy port (the OpenAI-compatible API listens here).
OPENCODE_PROXY_PORT=10000
# OpenCode backend port (the local `opencode serve` instance).
OPENCODE_SERVER_PORT=10001
# Host to bind. Use 127.0.0.1 to restrict to localhost.
BIND_HOST=0.0.0.0

# ---- Backend lifecycle (direct launch only; ignored in Docker) ----
# When true (the default for non-Docker runs), the proxy will spawn and
# supervise the `opencode serve` process automatically. Set to false if
# you start opencode manually and just want the proxy to talk to it.
OPENCODE_PROXY_MANAGE_BACKEND=true

# ---- Home directory isolation ----
# false (default) => reuse your real ~/.local/share/opencode (keeps login state)
# true            => use a throwaway jail in $TMPDIR/opencode-proxy-jail
OPENCODE_USE_ISOLATED_HOME=false

# ---- Prompt handling ----
OPENCODE_PROXY_PROMPT_MODE=standard
OPENCODE_PROXY_OMIT_SYSTEM_PROMPT=false

# ---- Auto cleanup of proxy-owned conversation/session storage ----
OPENCODE_PROXY_AUTO_CLEANUP_CONVERSATIONS=false
OPENCODE_PROXY_CLEANUP_INTERVAL_MS=43200000
OPENCODE_PROXY_CLEANUP_MAX_AGE_MS=86400000

# ---- Internal tool allowlist (used only when request has no `tools`) ----
# OPENCODE_INTERNAL_WEB_FETCH_ENABLED=false
# OPENCODE_INTERNAL_ALLOWED_TOOLS=web_fetch
# OPENCODE_INTERNAL_TOOL_METRICS_ENABLED=true
# OPENCODE_TOOL_DISCOVERY_FIXTURE=

# ---- Operational endpoints ----
OPENCODE_HEALTH_DETAILS_ENABLED=true
OPENCODE_HEALTH_DETAILS_REQUIRE_AUTH=true
OPENCODE_METRICS_ENABLED=false
OPENCODE_METRICS_REQUIRE_AUTH=true

# ---- Misc ----
# OPENCODE_PROXY_REQUEST_TIMEOUT_MS=180000
# OPENCODE_PROXY_DEBUG=false
# OPENCODE_ZEN_API_KEY=
